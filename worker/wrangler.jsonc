{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work-hours-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../app/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "work-hours-prod",
      "database_id": "fc1dd550-2886-4eb2-a616-616adf616d14",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "work-hours-reports",
    },
  ],
  "triggers": {
    // Standard 5-field cron syntax: [minute] [hour] [day-of-month] [month] [day-of-week]
    // Example: "0 0 1 * *"  -> Fires at 00:00 (midnight UTC) on the 1st day of every month
    // Example: "0 0 15 * *" -> Fires at 00:00 on the 15th day of every month
    // Example: "0 0 * * 1"  -> Fires at 00:00 every Monday
    "crons": ["0 0 1 * *"],
  },
}
