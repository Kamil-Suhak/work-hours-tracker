{
  "name": "work-hours-api",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "provision": "node scripts/provision-device.mjs",
    "deploy": "wrangler deploy",
    "db:purge": "wrangler d1 execute work-hours-prod --remote --file=sql/purge-shifts.sql",
    "db:purge-all": "wrangler d1 execute work-hours-prod --remote --file=sql/purge-all.sql",
    "db:devices": "wrangler d1 execute work-hours-prod --remote --file=sql/list-devices.sql",
    "db:status": "wrangler d1 execute work-hours-prod --remote --file=sql/inspect-state.sql",
    "db:shifts": "wrangler d1 execute work-hours-prod --remote --file=sql/recent-shifts.sql",
    "db:shift": "node scripts/shifts.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
