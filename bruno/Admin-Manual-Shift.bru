meta {
  name: Admin - Manual Shift Backfill
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/events/manual
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "requestId": "manual-{{$guid}}",
    "clockInAt": "2026-10-01T08:00:00.000Z",
    "clockOutAt": "2026-10-01T16:00:00.000Z",
    "reason": "Initial manual backfill test"
  }
}
