<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_surface_background">

    <!-- Header: Title and Manual Sync Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="WORK HOURS"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textColor="#94A3B8" />

        <ImageView
            android:id="@+id/btn_sync"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_sync"
            android:padding="4dp"
            android:contentDescription="Sync Status"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_status_out"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="○ CLOCKED OUT"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#94A3B8" />

        <TextView
            android:id="@+id/widget_sync_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Synced --:--"
            android:textSize="11sp"
            android:textColor="#64748B" />
    </LinearLayout>

    <!-- Pill Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_clock_in"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_in"
            android:text="▶ IN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_clock_out"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_out"
            android:text="■ OUT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Active Shift Notes Container (Visible when vertically expanded & clocked in) -->
    <LinearLayout
        android:id="@+id/widget_notes_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_notes_background"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_notes_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE NOTES"
            android:textStyle="bold"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:textColor="#10B981" />

        <TextView
            android:id="@+id/widget_notes_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:textColor="#CBD5E1"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
